{
  "COLORFUL_PHILOSOPHERS.pages.INITIAL.options.CARD_POOL∴INDOMITABLESPIRE2-INDOMITABLE_CARD_POOL.description": "获得[blue]{Cards}[/blue]张不挠的卡牌。",
