<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>TashkentSpire2.Impl</AssemblyName>
        <RootNamespace>TashkentSpire2</RootNamespace>
        <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/mod_manifest.json')), '&quot;version&quot;\s*:\s*&quot;v?([0-9.]+)&quot;').Groups[1].Value)</Version>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>$(DefaultItemExcludes);packages/**;.artifacts/**;build/**</DefaultItemExcludes>
        <BuildBundle Condition="'$(BuildBundle)' == ''">true</BuildBundle>
        <DeployBundle Condition="'$(DeployBundle)' == ''">true</DeployBundle>
        <StableSourceRef Condition="'$(StableSourceRef)' == ''">refs/heads/branch_tashkent_0.111.0</StableSourceRef>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
    </PropertyGroup>

    <!-- OS Detection -->
    <PropertyGroup>
        <IsWindows>false</IsWindows>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <!-- // NOTE: Megadot is version 4.5.1, and the game won't load your .pck if the Godot version used is newer. -->

    <!-- Windows -->
    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <PowerShellPath Condition="'$(PowerShellPath)' == ''">$(SystemRoot)/System32/WindowsPowerShell/v1.0/powershell.exe</PowerShellPath>
        <_BundlePowerShellPolicy>-ExecutionPolicy RemoteSigned</_BundlePowerShellPolicy>
        <AutoSteamPath Condition="'$(AutoSteamPath)' == '' and '$(SteamLibraryPath)' == '' and !Exists('D:/STEAM/steamapps/common/Slay the Spire 2')">$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
        <SteamLibraryPath Condition="Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>

        <GodotPath Condition="'$(GodotPath)' == ''">D:/Godot/Godot_v4.5.1-stable_mono_win64/Godot_v4.5.1-stable_mono_win64_console.exe</GodotPath>
        <!-- If on Windows and Slay the Spire 2 is not installed in your default steam library, adjust the following.-->
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">D:/STEAM/steamapps</SteamLibraryPath>
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- Linux -->
    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/.local/share/Steam/steamapps</SteamLibraryPath>
        <!-- Change the path here if using a downloaded binary instead of the Steam version-->
        <GodotPath Condition="'$(GodotPath)' == ''">$(SteamLibraryPath)/common/Godot Engine/godot.x11.opt.tools.64</GodotPath>

        <!-- The below should not need to be changed. -->
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- macOS -->
    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(HOME)/Applications/Godot_mono.app/Contents/MacOS/Godot</GodotPath>

        <!-- The below should not need to be changed. -->
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup>
        <PowerShellPath Condition="'$(PowerShellPath)' == ''">pwsh</PowerShellPath>
        <ModsPath Condition="'$(ModsPath)' == '' and '$(IsOSX)' == 'true'">$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods</ModsPath>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods</ModsPath>
        <_BundleModsPath Condition="'$(DeployBundle)' == 'true'">$(ModsPath)</_BundleModsPath>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DisableSteamworks)' == 'true'">
        <DefineConstants>$(DefineConstants);DISABLESTEAMWORKS</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <!-- Godot's editor loads the Debug assembly while exporting resources. -->
            <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
            <Private Condition="'$(Configuration)' != 'Debug'">false</Private>
        </Reference>
        <Reference Include="Steamworks.NET" Condition="'$(DisableSteamworks)' != 'true' and Exists('$(Sts2DataDir)/Steamworks.NET.dll')">
            <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.4.8" PrivateAssets="All" />
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.1.6" />
        <AdditionalFiles Include="TashkentSpire2/localization/**/*.json"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <Compile Remove="TashkentSpire2/images/**" />
        <Compile Remove="TashkentSpire2/scenes/**" />
        <Compile Remove="TashkentSpire2/materials/**" />
        <Compile Remove="TashkentSpire2/shaders/**" />
        <EmbeddedResource Remove="TashkentSpire2/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore"/>
        <None Update="mod_manifest.json" />
        <None Include="project.godot"/>
        <None Include="TashkentSpire2/**"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="TashkentSpire2\images\card_portraits\big\"/>
        <Folder Include="TashkentSpire2\images\packed\sprite_fonts\" />
        <Folder Include="TashkentSpire2\images\powers\big\"/>
        <Folder Include="TashkentSpire2\images\relics\big\"/>
        <Folder Include="TashkentSpire2\scenes\vfx\energy\" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths">
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)/sts2.dll')"/>
        <Error
                Text=" Godot not found at path '$(GodotPath)'"
                Condition="'$(BuildBundle)' == 'true' and '$(DesignTimeBuild)' != 'true' and ('$(GodotPath)' == '' or !Exists('$(GodotPath)'))"/>
    </Target>

    <Target Name="AssembleModBundle" AfterTargets="Build"
            Condition="'$(BuildBundle)' == 'true' and '$(DesignTimeBuild)' != 'true'">
        <Error Text="Set StableSts2DataDir in Directory.Build.props to the Slay the Spire 2 0.111.0 data directory."
               Condition="'$(StableSts2DataDir)' == '' or !Exists('$(StableSts2DataDir)/sts2.dll')" />
        <Exec Command="&quot;$(PowerShellPath)&quot; -NoProfile -NonInteractive $(_BundlePowerShellPolicy) -File &quot;$(MSBuildProjectDirectory)/build/Build-Bundle.ps1&quot; -Configuration &quot;$(Configuration)&quot; -Godot &quot;$(GodotPath)&quot; -StableDataDir &quot;$(StableSts2DataDir)&quot; -BetaDataDir &quot;$(Sts2DataDir)&quot; -BetaGameDir &quot;$(Sts2Path)&quot; -StableSourceRef &quot;$(StableSourceRef)&quot; -BetaDll &quot;$(TargetPath)&quot;"
              WorkingDirectory="$(MSBuildProjectDirectory)"
              EnvironmentVariables="TASHKENT_BUNDLE_MODS_PATH=$(_BundleModsPath)"
              UseUtf8Encoding="Always" />
    </Target>
</Project>
